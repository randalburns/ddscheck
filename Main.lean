import DdsCheck.Format
import DdsCheck.Par

/-!
# ddscheck: verify a certificate file written by `ddscert`

`ddscheck file.cert` checks each result and reports it. `ddscheck --lean out.lean file.cert`
instead writes a Lean file with one theorem per result, which `lake env lean` then checks.
-/

open Bridge Bridge.Format

def showSuit (cs : List Card) (s : Suit) : String :=
  let held := cs.filter (·.suit == s)
  let names := "23456789TJQKA".toList
  String.ofList (held.map fun c => names.getD (c.rank - 2) '?')

def showHand (cs : List Card) : String :=
  ".".intercalate ([Suit.spades, .hearts, .diamonds, .clubs].map (showSuit cs))

def showDeal (h : Hands) : String :=
  "N:" ++ " ".intercalate ([h.north, h.east, h.south, h.west].map showHand)

def showStrain : Strain → String
  | none => "NT" | some .spades => "S" | some .hearts => "H"
  | some .diamonds => "D" | some .clubs => "C"

def showSeat : Seat → String
  | .north => "N" | .east => "E" | .south => "S" | .west => "W"

def cardTerm (c : Card) : String :=
  let suit := match c.suit with
    | .spades => ".spades" | .hearts => ".hearts" | .diamonds => ".diamonds" | .clubs => ".clubs"
  s!"⟨{suit}, {c.rank}⟩"

def listTerm (cs : List Card) : String :=
  "[" ++ ", ".intercalate (cs.map cardTerm) ++ "]"

def strainTerm : Strain → String
  | none => "none" | some .spades => "some .spades" | some .hearts => "some .hearts"
  | some .diamonds => "some .diamonds" | some .clubs => "some .clubs"

def seatTerm : Seat → String
  | .north => ".north" | .east => ".east" | .south => ".south" | .west => ".west"

def hexOf (bytes : ByteArray) : String := Id.run do
  let digits := "0123456789abcdef".toList.toArray
  let mut out := ""
  for b in bytes do
    out := (out.push digits[(b / 16).toNat]!).push digits[(b % 16).toNat]!
  return out

/-- A Lean file with one theorem per record. The statements spell out the deal, so reading
them requires no trust in the certificate or the parser. -/
def leanFile (hexName : String) (rs : Array (Nat × Record)) : String := Id.run do
  let some (_, first) := rs[0]? | return ""
  let h := first.claim.hands
  let mut out := s!"import DdsCheck.Format

open Bridge Bridge.Format

/-! Generated by `ddscheck --lean`. Deal: {showDeal h} -/

namespace DealProof

def deal : Hands where
  north := {listTerm h.north}
  east := {listTerm h.east}
  south := {listTerm h.south}
  west := {listTerm h.west}

def bytes : ByteArray := decodeHex (include_str \"{hexName}\")

"
  let mut names : Array String := #[]
  for (offset, rc) in rs do
    if rc.claim.hands != h then
      panic! "a certificate file must hold a single deal"
    let c := rc.claim
    let name := s!"{showStrain c.strain}_{showSeat c.leader}_leads"
    names := names.push name
    out := out ++ s!"/-- The deal is valid and, in {showStrain c.strain} with {showSeat c.leader} on lead, North-South take exactly {c.nsTricks}. -/
theorem {name} : validDeal deal ∧ nsTricks ({strainTerm c.strain}) deal {seatTerm c.leader} = {c.nsTricks} :=
  let r := recordAt bytes {offset}
  (checkClaim_sound ⟨{strainTerm c.strain}, deal, {seatTerm c.leader}, {c.nsTricks}⟩
    r.entries r.nsFact r.ewFact (by native_decide))

"
  out := out ++ "end DealProof\n\n"
  for name in names do
    out := out ++ s!"#print axioms DealProof.{name}\n"
  return out

def writeLean (outPath certPath : String) : IO UInt32 := do
  let bytes ← IO.FS.readBinFile certPath
  match records bytes with
  | .error e =>
    IO.eprintln s!"{certPath}: malformed certificate: {e}"
    return 2
  | .ok rs =>
    let hexPath := outPath ++ ".hex"
    IO.FS.writeFile hexPath (hexOf bytes)
    let hexName := (System.FilePath.mk hexPath).fileName.getD hexPath
    IO.FS.writeFile outPath (leanFile hexName rs)
    IO.println s!"wrote {outPath} ({rs.size} theorems); check it with: lake env lean {outPath}"
    return 0

/-! ## Par -/

def parseVul : String → Option Vulnerability
  | "none" => some .none | "both" => some .both | "ns" => some .ns | "ew" => some .ew
  | _ => none

def parseSeat : String → Option Seat
  | "N" => some .north | "E" => some .east | "S" => some .south | "W" => some .west
  | _ => none

def vulTerm : Vulnerability → String
  | .none => ".none" | .both => ".both" | .ns => ".ns" | .ew => ".ew"

def allStrains : List Strain := [some .spades, some .hearts, some .diamonds, some .clubs, none]
def allSeats : List Seat := [.north, .east, .south, .west]

/-- The seat to the right of `leader`: the declarer when `leader` is on lead. -/
def declarerFor (leader : Seat) : Seat := leader.next.next.next

/-- The tricks for declarer that a claim states. -/
def declarerClaim (c : Claim) : Nat :=
  match (declarerFor c.leader).side with
  | .ns => c.nsTricks
  | .ew => 13 - c.nsTricks

/-- Read one record per file, requiring one deal and exactly the 20 results of its table. -/
def loadTable (paths : List String) : IO (Except String (Array (String × Record))) := do
  let mut acc : Array (String × Record) := #[]
  for path in paths do
    match records (← IO.FS.readBinFile path) with
    | .error e => return .error s!"{path}: malformed certificate: {e}"
    | .ok rs =>
      for (_, rc) in rs do
        acc := acc.push (path, rc)
  let some (_, first) := acc[0]? | return .error "no certificates given"
  for (path, rc) in acc do
    if rc.claim.hands != first.claim.hands then
      return .error s!"{path}: a different deal from the others"
  for strain in allStrains do
    for seat in allSeats do
      let n := (acc.filter fun (_, r) => r.claim.strain == strain && r.claim.leader == seat).size
      if n != 1 then
        return .error s!"expected one result for {showStrain strain} with {showSeat seat} on lead, found {n}"
  return .ok acc

def findClaim (acc : Array (String × Record)) (strain : Strain) (leader : Seat) : Option Claim :=
  (acc.find? fun (_, r) => r.claim.strain == strain && r.claim.leader == leader).map (·.2.claim)

/-- Check all 20 results, then compare the par they imply with DDS's score. -/
def checkPar (v : Vulnerability) (dealer : Seat) (ddsScore : Int) (paths : List String) : IO UInt32 := do
  match ← loadTable paths with
  | .error e =>
    IO.eprintln e
    return 2
  | .ok acc =>
    let mut rejected := 0
    for (_, rc) in acc do
      unless checkClaim rc.claim rc.entries rc.nsFact rc.ewFact do
        rejected := rejected + 1
        IO.println s!"REJECTED {showStrain rc.claim.strain}, {showSeat rc.claim.leader} leads"
    if rejected > 0 then
      IO.println s!"{rejected} of the table's results rejected; par not established"
      return 1
    let t : Table := fun strain d =>
      ((findClaim acc strain d.next).map declarerClaim).getD 0
    let par := parFast t v dealer
    IO.println s!"20 table results proved; par is {par} from North-South's point of view"
    if par == ddsScore then
      IO.println s!"PROVED   DDS par score {ddsScore} is correct"
      return 0
    else
      IO.println s!"REJECTED DDS par score {ddsScore} differs from the proved value {par}"
      return 1

/-- A Lean file proving the whole table, and par from it. Each result gets its own hex file. -/
def writeParLean (out : String) (v : Vulnerability) (dealer : Seat) (ddsScore : Int)
    (paths : List String) : IO UInt32 := do
  match ← loadTable paths with
  | .error e =>
    IO.eprintln e
    return 2
  | .ok acc =>
    let some (_, first) := acc[0]? | return 2
    let h := first.claim.hands
    let mut text := s!"import DdsCheck.Format
import DdsCheck.Par

open Bridge Bridge.Format

/-! Generated by `ddscheck --par-lean`. Deal: {showDeal h} -/

namespace DealProof

def deal : Hands where
  north := {listTerm h.north}
  east := {listTerm h.east}
  south := {listTerm h.south}
  west := {listTerm h.west}

"
    let mut names : Array String := #[]
    for (path, rc) in acc do
      let c := rc.claim
      let name := s!"{showStrain c.strain}_{showSeat c.leader}_leads"
      names := names.push name
      let hexPath := s!"{out}.{name}.hex"
      IO.FS.writeFile hexPath (hexOf (← IO.FS.readBinFile path))
      let hexName := (System.FilePath.mk hexPath).fileName.getD hexPath
      text := text ++ s!"def bytes_{name} : ByteArray := decodeHex (include_str \"{hexName}\")

theorem {name} : validDeal deal ∧ nsTricks ({strainTerm c.strain}) deal {seatTerm c.leader} = {c.nsTricks} :=
  let r := recordAt bytes_{name} 0
  checkClaim_sound ⟨{strainTerm c.strain}, deal, {seatTerm c.leader}, {c.nsTricks}⟩
    r.entries r.nsFact r.ewFact (by native_decide)

"
    text := text ++ "/-- The tricks declarer takes, for each strain and declarer. -/\ndef table : Table\n"
    let mut cases := ""
    for strain in allStrains do
      for seat in allSeats do
        let some c := findClaim acc strain seat.next | return 2
        text := text ++ s!"  | {strainTerm strain}, {seatTerm seat} => {declarerClaim c}\n"
        cases := cases ++ s!"  | {strainTerm strain}, {seatTerm seat} => exact declarerTricks_of (k := {c.nsTricks}) {showStrain strain}_{showSeat seat.next}_leads.2\n"
    let firstName := names[0]!
    text := text ++ s!"
theorem table_eq : declarerTricks deal = table := by
  funext strain d
  match strain, d with
{cases}
/-- **Par for this deal**, from North-South's point of view. -/
theorem par : validDeal deal ∧ dealPar deal {vulTerm v} {seatTerm dealer} = ({ddsScore} : Int) :=
  ⟨{firstName}.1, by rw [dealPar_eq _ _ _ table table_eq]; decide +kernel⟩

end DealProof

#print axioms DealProof.par
"
    IO.FS.writeFile out text
    IO.println s!"wrote {out}; check it with: lake env lean {out}"
    return 0

/-- Check one file, returning the numbers of results proved and rejected. -/
def checkFile (path : String) : IO (Nat × Nat) := do
  let bytes ← IO.FS.readBinFile path
  match records bytes with
  | .error e =>
    IO.eprintln s!"{path}: malformed certificate: {e}"
    return (0, 1)
  | .ok rs =>
    let mut accepted := 0
    let mut rejected := 0
    for (_, rc) in rs do
      let c := rc.claim
      let ok := checkClaim c rc.entries rc.nsFact rc.ewFact
      let verdict := if ok then "PROVED  " else "REJECTED"
      if ok then accepted := accepted + 1 else rejected := rejected + 1
      IO.println s!"{verdict} {showDeal c.hands}  {showStrain c.strain}, {showSeat c.leader} leads: North-South take {c.nsTricks}, East-West take {13 - c.nsTricks} ({rc.entries.length} facts)"
    return (accepted, rejected)

def main : List String → IO UInt32
  | ["--lean", out, path] => writeLean out path
  | "--par" :: vul :: dealer :: score :: paths =>
    match parseVul vul, parseSeat dealer, score.toInt? with
    | some v, some d, some x => checkPar v d x paths
    | _, _, _ => do
      IO.eprintln "usage: ddscheck --par none|both|ns|ew N|E|S|W <score> <file.cert>..."
      return 2
  | "--par-lean" :: out :: vul :: dealer :: score :: paths =>
    match parseVul vul, parseSeat dealer, score.toInt? with
    | some v, some d, some x => writeParLean out v d x paths
    | _, _, _ => do
      IO.eprintln "usage: ddscheck --par-lean <out.lean> none|both|ns|ew N|E|S|W <score> <file.cert>..."
      return 2
  | [] => do
    IO.eprintln "usage: ddscheck <file.cert>...\n       ddscheck --lean <out.lean> <file.cert>\n       ddscheck --par none|both|ns|ew N|E|S|W <score> <file.cert>...\n       ddscheck --par-lean <out.lean> none|both|ns|ew N|E|S|W <score> <file.cert>..."
    return 2
  | paths => do
    let mut accepted := 0
    let mut rejected := 0
    for path in paths do
      let (a, r) ← checkFile path
      accepted := accepted + a
      rejected := rejected + r
    IO.println s!"{accepted} proved, {rejected} rejected"
    return if rejected == 0 && accepted > 0 then 0 else 1
